#!/bin/bash
#PBS -N pyses_sctrace
#PBS -A P93300042
#PBS -q develop
#PBS -l job_priority=premium
#PBS -l select=1:ncpus=32:mem=160GB:ngpus=2
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/owhughes/pyses_profiling/

# Attribute the poor 2-GPU strong scaling: jax profiler traces of the NX15
# fp64 baroclinic wave on 1 GPU and on 2 GPUs, plus device-time aggregation.

REPO=/glade/work/owhughes/development/python/pyses_07_02_26
PROFROOT=/glade/derecho/scratch/owhughes/pyses_profiling
OUT=$PROFROOT/sctrace_${PBS_JOBID%%.*}
PY=$REPO/.venv/bin/python
mkdir -p "$OUT"/gpu1 "$OUT"/gpu2
cd "$REPO" || exit 1

export PYSES_BACKEND=jax
export PYSES_USE_CPU=0
export JAX_COMPILATION_CACHE_DIR=$PROFROOT/jax_cache

echo "=== [1/3] 1-GPU trace ==="
CUDA_VISIBLE_DEVICES=0 $PY profiling/profile_baro_wave.py --nx 15 \
    --mode trace --profile-steps 3 --warmup 2 --outdir "$OUT"/gpu1 \
    > "$OUT"/gpu1.log 2>&1
echo "exit: $?"

echo "=== [2/3] 2-GPU trace ==="
CUDA_VISIBLE_DEVICES=0,1 $PY profiling/profile_baro_wave.py --nx 15 \
    --mode trace --profile-steps 3 --warmup 2 --outdir "$OUT"/gpu2 \
    > "$OUT"/gpu2.log 2>&1
echo "exit: $?"

echo "=== [3/3] aggregate device time ==="
for g in gpu1 gpu2; do
  TR=$(find "$OUT"/$g/jax_trace -name "*.trace.json.gz" | head -1)
  $PY profiling/analyze_jax_trace.py --trace "$TR" --steps 3 --top 30 \
      --out "$OUT"/$g/trace_report.json > "$OUT"/${g}_report.log 2>&1
  echo "$g analysis exit: $?"
done
