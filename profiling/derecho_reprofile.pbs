#!/bin/bash
#PBS -N pyses_reprof
#PBS -A P93300042
#PBS -q develop
#PBS -l job_priority=premium
#PBS -l select=1:ncpus=16:mem=80GB:ngpus=1
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/owhughes/pyses_profiling/

# Derecho variant of casper_reprofile.pbs (develop queue, premium priority;
# Derecho GPU nodes carry the same A100-SXM4-80GB as Casper's).

REPO=/glade/work/owhughes/development/python/pyses_07_02_26
PROFROOT=/glade/derecho/scratch/owhughes/pyses_profiling
OUT=$PROFROOT/reprofile_${PBS_JOBID%%.*}
PY=$REPO/.venv/bin/python
mkdir -p "$OUT"/fp64 "$OUT"/fp32
cd "$REPO" || exit 1

module load cuda 2>/dev/null
NSYS=$(command -v nsys)

export PYSES_BACKEND=jax
export PYSES_USE_CPU=0
export JAX_COMPILATION_CACHE_DIR=$PROFROOT/jax_cache

nvidia-smi --query-gpu=name,memory.total --format=csv > "$OUT"/gpu_info.txt 2>&1

echo "=== [1/4] fp64 timing + components + cost ==="
$PY profiling/profile_baro_wave.py --mode timing,components,cost \
    --steps 20 --warmup 3 --outdir "$OUT"/fp64 > "$OUT"/fp64.log 2>&1
echo "stage 1 exit: $?"

echo "=== [2/4] fp32 timing ==="
$PY profiling/profile_baro_wave.py --mode timing --steps 20 --warmup 3 \
    --float32 --outdir "$OUT"/fp32 > "$OUT"/fp32.log 2>&1
echo "stage 2 exit: $?"

if [ -n "$NSYS" ]; then
  echo "=== [3/4] nsys capture (fp64, graph-node tracing) ==="
  "$NSYS" profile -c cudaProfilerApi --trace=cuda --sample=none \
      --cuda-graph-trace=node --force-overwrite=true -o "$OUT"/fp64/baro_nsys \
      $PY profiling/profile_baro_wave.py --mode nsys --profile-steps 3 --warmup 2 \
      --outdir "$OUT"/fp64 > "$OUT"/nsys.log 2>&1
  echo "stage 3 exit: $?"
  "$NSYS" export --type sqlite --force-overwrite=true \
      -o "$OUT"/fp64/baro_nsys.sqlite "$OUT"/fp64/baro_nsys.nsys-rep \
      >> "$OUT"/nsys.log 2>&1

  echo "=== [4/4] hotspot attribution ==="
  $PY profiling/analyze_hlo_hotspots.py \
      --sqlite "$OUT"/fp64/baro_nsys.sqlite \
      --hlo "$OUT"/fp64/coupling_step_hlo.txt \
      --steps 3 --top 40 --out "$OUT"/fp64/hotspots.json > "$OUT"/hotspots.log 2>&1
  echo "stage 4 exit: $?"
else
  echo "nsys not found; skipping stages 3-4"
fi

echo "=== done: $OUT ==="
ls -l "$OUT" "$OUT"/fp64
