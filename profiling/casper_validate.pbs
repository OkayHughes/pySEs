#!/bin/bash
#PBS -N pyses_valid
#PBS -A P93300042
#PBS -q casper
#PBS -l select=1:ncpus=8:mem=80GB:ngpus=1:gpu_type=a100
#PBS -l walltime=01:00:00
#PBS -j oe

# Validate the profiling conclusions:
#  A) micro-benchmark of the 2x2 metric contraction (einsum-vs-unrolled) under
#     default flags and with the gemm-rewrite threshold raised;
#  B) full NX16 model timing/components with the threshold raised (fp64, fp32).

REPO=/glade/work/owhughes/development/python/pyses_07_02_26
PROFROOT=/glade/derecho/scratch/owhughes/pyses_profiling
OUT=$PROFROOT/validate_${PBS_JOBID%%.*}
PY=$REPO/.venv/bin/python
mkdir -p "$OUT"
cd "$REPO" || exit 1

export PYSES_BACKEND=jax
export PYSES_USE_CPU=0
export JAX_COMPILATION_CACHE_DIR=$PROFROOT/jax_cache

echo "=== [A1] micro-benchmark, default flags ==="
$PY profiling/bench_metric_transform.py > "$OUT"/bench_default.log 2>&1
echo "exit: $?"

echo "=== [A2] micro-benchmark, gemm_rewrite_size_threshold=10000 ==="
XLA_FLAGS="--xla_gpu_gemm_rewrite_size_threshold=10000" \
  $PY profiling/bench_metric_transform.py > "$OUT"/bench_thresh10k.log 2>&1
echo "exit: $?"

echo "=== [B1] full model fp64 timing+components, threshold=10000 ==="
XLA_FLAGS="--xla_gpu_gemm_rewrite_size_threshold=10000" \
  $PY profiling/profile_baro_wave.py --mode timing,components --steps 20 --warmup 3 \
  --outdir "$OUT"/fp64_thresh > "$OUT"/fp64_thresh.log 2>&1
echo "exit: $?"

echo "=== [B2] full model fp32 timing, threshold=10000 ==="
XLA_FLAGS="--xla_gpu_gemm_rewrite_size_threshold=10000" \
  $PY profiling/profile_baro_wave.py --mode timing --steps 20 --warmup 3 --float32 \
  --outdir "$OUT"/fp32_thresh > "$OUT"/fp32_thresh.log 2>&1
echo "exit: $?"

echo "=== [B3] full model fp64 timing, threshold=1000000 (all small dots fused) ==="
XLA_FLAGS="--xla_gpu_gemm_rewrite_size_threshold=1000000" \
  $PY profiling/profile_baro_wave.py --mode timing --steps 20 --warmup 3 \
  --outdir "$OUT"/fp64_thresh1m > "$OUT"/fp64_thresh1m.log 2>&1
echo "exit: $?"

echo "=== done: $OUT ==="
ls -l "$OUT"
